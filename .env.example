# Copy this to .env and fill in real values. Do NOT commit the real .env.

# ---- Omada Controller / Open API -------------------------------------------
# Global View > Settings > Platform Integrations > Open API in your
# controller UI is where you register an application and get these.
# OMADAC_ID is the controller ID, visible in that same panel.
OMADA_BASE_URL=https://192.168.0.2:8043
OMADA_CLIENT_ID=
OMADA_CLIENT_SECRET=
OMADA_OMADAC_ID=
OMADA_SITE_ID=
# Serial number / MAC of the ER605 as shown in the controller's device list.
OMADA_GATEWAY_MAC=

# Whether to verify the Omada controller's TLS certificate. false disables
# verification entirely -- fine for a self-signed local controller cert,
# but worth setting true if your controller has a real trusted cert
# (Omada Central almost certainly does, being cloud-hosted).
OMADA_VERIFY_TLS=false

# WAN port identifiers -- confirmed via GET /openapi/v1/{omadacId}/sites/{siteId}/internet/ports-config
# These are NOT plain integers -- real format is like "1_8ff0def98a03428b93d15678efa14052".
# Match by portName ("WAN" vs "WAN/LAN1") or by the hostname you set on each
# WAN's DHCP config, then copy the exact portId string.
WAN_PRIMARY_PORT_ID=
WAN_BACKUP_PORT_ID=

# ---- Probe targets -----------------------------------------------------
# Multiple targets averaged together so one flaky resolver/anycast node
# doesn't trigger a false failover. Mix providers.
PING_TARGETS=1.1.1.1,8.8.8.8,9.9.9.9

# ---- Thresholds ----------------------------------------------------------
# A cycle is "bad" if EITHER threshold is breached across the aggregated
# probe results for that cycle.
LATENCY_THRESHOLD_MS=150
PACKET_LOSS_THRESHOLD_PCT=15

# How many consecutive bad cycles before we actually trigger failover.
# At CHECK_INTERVAL_SECONDS=5 and this=12, that's ~60s to trigger -- your
# target of cutting failover time to ~1 minute, with room to tune down.
CONSECUTIVE_BAD_TO_TRIGGER=12

# How many consecutive good cycles before we're willing to fail back
# automatically. NOTE: no longer used for the fail-back decision -- kept
# only because update_streaks() computes it alongside consecutive_bad.
# Fail-back is now based on PRIMARY_HEALTH_POLL_INTERVAL_SECONDS /
# PRIMARY_HEALTHY_STABILITY_SECONDS below, which query the primary WAN's
# actual status instead of inferring it from LAN-side ping health.
CONSECUTIVE_GOOD_TO_FAILBACK=24

# A single cycle going against the current streak (e.g. one bad cycle
# during an otherwise clean run of good ones) doesn't immediately reset
# that streak -- it takes this many CONSECUTIVE opposite cycles to actually
# break it. 1 = strict/old behavior (any single opposite cycle resets
# everything). 2 absorbs isolated single-cycle noise (one dropped ping to
# one of several targets) without weakening real degradation detection.
STREAK_TOLERANCE_CYCLES=2

# How often to query the primary WAN's real status via the Omada API (a
# read-only call, separate cadence from CHECK_INTERVAL_SECONDS since it's
# an actual API request, not a local ping).
PRIMARY_HEALTH_POLL_INTERVAL_SECONDS=30

# Once the primary is reported healthy via the API, require it to stay
# continuously healthy for this long before fail-back is even considered.
# Any single unhealthy poll during this window resets the clock to zero.
# Default 300s (5 min) -- deliberately conservative.
PRIMARY_HEALTHY_STABILITY_SECONDS=300

# "Healthy" for fail-back requires internetState==1 AND latency/loss (from
# that same wan-status response, the router's own probe of the primary)
# within these thresholds. internetState alone isn't enough -- a WAN can
# report "connected" while still degraded the same way that caused the
# original failover. Intentionally stricter than LATENCY_THRESHOLD_MS /
# PACKET_LOSS_THRESHOLD_PCT above (which gate the LAN-ping failover
# trigger) -- the bar for "trustworthy enough to fail back onto" should be
# higher than the bar for "bad enough to fail off of," or you risk failing
# back onto a link that's merely just-below the failure threshold.
PRIMARY_HEALTHY_LATENCY_THRESHOLD_MS=100
PRIMARY_HEALTHY_LOSS_THRESHOLD_PCT=5

# IMPORTANT: even once the primary is confirmed healthy for the full
# stability window, false (default) here means fail-back still only logs
# a reminder and does NOT call the Omada API -- run
# ./test_load_balance_swap.sh failback manually. check_primary_wan_health()
# is confirmed working as of 2026-07-29 -- set true once you've watched it
# correctly detect at least one real recovery in the logs and trust it.
AUTO_FAILBACK_ENABLED=false

# Minimum seconds between any two failover actions, regardless of what the
# probes say. This is the real anti-flap guard -- even if the network is
# genuinely bouncing, we won't hammer the router with switch commands.
COOLDOWN_SECONDS=120

# How often (seconds) the main loop runs a full ping cycle against all
# PING_TARGETS. Lower = faster detection but more ping traffic/CPU.
CHECK_INTERVAL_SECONDS=5

# How many pings to send per target, per cycle. Averaged together with the
# other targets' results to compute that cycle's latency/loss.
PING_COUNT_PER_CYCLE=3

# Per-ping timeout (seconds) before that individual ping counts as lost.
PING_TIMEOUT_SECONDS=2

# ---- Throughput sampling (optional, off by default) -----------------------
# Latency/loss catches "down" and "flaky" well but not "up, low loss, but
# crawling at 200kbps." This does a small timed download periodically to
# catch that case. Keep the interval long and the sample small -- it's real
# billed bandwidth on cellular/satellite backups.
ENABLE_THROUGHPUT_CHECK=false
THROUGHPUT_CHECK_EVERY_N_CYCLES=60
THROUGHPUT_TEST_URL=https://speed.cloudflare.com/__down?bytes=2000000
THROUGHPUT_MIN_MBPS=5

# ---- Metrics database / dashboard -----------------------------------
# Path to the shared SQLite db (inside the container -- /data is the
# mounted named volume, see docker-compose.yml). Both monitor.py (writer)
# and dashboard.py (reader) use this same path.
DB_PATH=/data/wan-monitor.db

# How long to keep cycle/event history before old rows are pruned. At
# CHECK_INTERVAL_SECONDS=5 that's roughly 17k rows/day -- raise this if you
# want a longer history for the dashboard or an ISP dispute.
RETENTION_DAYS=90

# Port the dashboard web UI listens on (http://<host>:DASHBOARD_PORT).
DASHBOARD_PORT=8090

# IANA timezone name for the dashboard's table/CSV timestamps (the chart
# already uses your browser's local timezone automatically -- this only
# affects the server-rendered table and CSV export). Container defaults to
# UTC otherwise, which is why timestamps looked like GMT regardless of
# where you actually are. DST-aware (PDT/PST switch automatically).
DASHBOARD_TIMEZONE=America/Los_Angeles

# How often (seconds) the dashboard auto-refreshes chart/table data while
# "Live" is enabled. Lower = more current but more requests against the db.
DASHBOARD_REFRESH_INTERVAL_SECONDS=15

# ---- Misc ------------------------------------------------------------
LOG_LEVEL=INFO
# DRY_RUN=true logs exactly what it would do without calling the Omada API.
# Run with this on first, watch the logs for a day, THEN flip it off.
DRY_RUN=true
